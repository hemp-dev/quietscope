#!/bin/sh
# Lightweight pre-commit hook to verify staged Go files.

set -e

# ANSI escape codes for coloring
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo "=== Running local pre-commit checks ==="

# Get staged Go files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_FILES" ]; then
    echo "Checking staged Go files..."
    
    # 1. Format check using gofmt
    UNFORMATTED=""
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            if [ -n "$(gofmt -l "$file" 2>/dev/null)" ]; then
                UNFORMATTED="$UNFORMATTED\n  - $file"
            fi
        fi
    done
    
    if [ -n "$UNFORMATTED" ]; then
        echo "${RED}❌ Error: The following staged Go files are not formatted correctly. Please run 'go fmt' on them:${NC}"
        printf "$UNFORMATTED\n"
        exit 1
    fi
    echo "${GREEN}✅ Go formatting check passed${NC}"
fi

# 2. Run go vet on the codebase
echo "Running go vet..."
if ! go vet ./...; then
    echo "${RED}❌ Go vet failed${NC}"
    exit 1
fi
echo "${GREEN}✅ Go vet passed${NC}"

# 3. Check compilation
echo "Checking that the code compiles..."
if ! go test -run=^$ ./... > /dev/null; then
    echo "${RED}❌ Compilation check failed${NC}"
    exit 1
fi
echo "${GREEN}✅ Code compilation verified${NC}"

echo "=== ${GREEN}All pre-commit checks passed successfully!${NC} ==="
